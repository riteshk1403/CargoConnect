# CargoConnect Backend Production Environment Variables Template
# Copy this to .env or configure in hosting provider (e.g., Render, Railway, Docker)

# Server Port (Auto-assigned by Render / Railway / Heroku)
PORT=8080

# Managed Database Credentials (e.g. Aiven, TiDB Cloud, Railway MySQL, Clever Cloud)
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Alternative Discrete Database Config (if URL is not used)
DB_HOST=<YOUR_DB_HOST>
DB_PORT=3306
DB_NAME=cargoconnect
DB_USERNAME=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# JWT Secret (64-byte Hex / Base64 string for HMAC-SHA256 signature)
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# Frontend Production URL (e.g., https://cargoconnect.vercel.app)
FRONTEND_URL=https://<YOUR_FRONTEND_DOMAIN>.vercel.app

# Razorpay Production / Test Credentials
RAZORPAY_KEY_ID=rzp_test_TYHJ7KO4FMfsNu
RAZORPAY_KEY_SECRET=j0rKh9oAMGCOobGdaWFfg5AW
RAZORPAY_WEBHOOK_SECRET=rzp_test_WebhookSecret123

# SMTP Production Mail Service (Gmail, SendGrid, Mailgun, Amazon SES)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<YOUR_MAIL_ADDRESS>
MAIL_PASSWORD=<YOUR_APP_PASSWORD>
